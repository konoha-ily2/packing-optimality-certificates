namespace PackLean.D87Dod

structure Z5 where
  a : Int
  b : Int
deriving DecidableEq, Repr

namespace Z5
def add (x y : Z5) : Z5 := ⟨x.a + y.a, x.b + y.b⟩
def sub (x y : Z5) : Z5 := ⟨x.a - y.a, x.b - y.b⟩
def mul (x y : Z5) : Z5 := ⟨x.a * y.a + 5 * x.b * y.b, x.a * y.b + x.b * y.a⟩
def ofInt (n : Int) : Z5 := ⟨n, 0⟩
/-- a + b sqrt 5 >= 0 -/
def nonneg (x : Z5) : Bool :=
  if 0 ≤ x.a then (0 ≤ x.b || 5 * x.b * x.b ≤ x.a * x.a) else (0 < x.b && x.a * x.a ≤ 5 * x.b * x.b)
def le (x y : Z5) : Bool := nonneg (sub y x)
def pos (x : Z5) : Bool := nonneg x && x != ⟨0, 0⟩
end Z5

abbrev V := List Z5
def zero : Z5 := ⟨0, 0⟩
def dot (u w : V) : Z5 := (List.zipWith Z5.mul u w).foldl Z5.add zero
def vadd (u w : V) : V := List.zipWith Z5.add u w
def vsub (u w : V) : V := List.zipWith Z5.sub u w
def vneg (u : V) : V := u.map (fun x => Z5.sub zero x)
def smul (s : Z5) (u : V) : V := u.map (Z5.mul s)
def cross : V → V → V
  | [a0, a1, a2], [b0, b1, b2] =>
    [Z5.sub (Z5.mul a1 b2) (Z5.mul a2 b1), Z5.sub (Z5.mul a2 b0) (Z5.mul a0 b2), Z5.sub (Z5.mul a0 b1) (Z5.mul a1 b0)]
  | _, _ => []
def nth (l : List α) (i : Nat) (d : α) : α := l.getD i d
def pairs (n : Nat) : List (Nat × Nat) :=
  (List.range n).flatMap (fun i => ((List.range n).filter (fun j => i < j)).map (fun j => (i, j)))
def isZero (u : V) : Bool := u.all (· == zero)
def sqz (k : Int) : Z5 := Z5.ofInt (k * k)

