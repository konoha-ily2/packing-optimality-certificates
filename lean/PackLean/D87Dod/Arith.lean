  (6, 10, [⟨-4, 2⟩, ⟨3, -1⟩, ⟨0, 0⟩]),
  (6, 11, [⟨-4, 2⟩, ⟨-3, 1⟩, ⟨0, 0⟩]),
  (6, 12, [⟨0, 0⟩, ⟨4, -2⟩, ⟨-3, 1⟩]),
  (7, 8, [⟨20, -8⟩, ⟨10, -4⟩, ⟨15, -5⟩]),
  (7, 9, [⟨-4, 2⟩, ⟨3, -1⟩, ⟨0, 0⟩]),
  (7, 10, [⟨-4, 2⟩, ⟨3, -1⟩, ⟨0, 0⟩]),
  (7, 11, [⟨0, 2⟩, ⟨-25, 11⟩, ⟨0, 0⟩]),
  (7, 12, [⟨20, -8⟩, ⟨10, -4⟩, ⟨-15, 5⟩]),
  (8, 9, [⟨20, -10⟩, ⟨-5, 3⟩, ⟨10, -6⟩]),
  (8, 10, [⟨-20, 10⟩, ⟨-5, 3⟩, ⟨10, -6⟩]),
  (8, 11, [⟨0, 0⟩, ⟨4, -2⟩, ⟨-3, 1⟩]),
  (8, 12, [⟨0, 0⟩, ⟨4, -2⟩, ⟨-3, 1⟩]),
  (9, 10, [⟨-20, 10⟩, ⟨-5, 3⟩, ⟨-10, 6⟩]),
  (9, 11, [⟨0, 0⟩, ⟨4, -2⟩, ⟨3, -1⟩]),
  (9, 12, [⟨0, 0⟩, ⟨0, -2⟩, ⟨-25, 11⟩]),
  (10, 11, [⟨-5, 3⟩, ⟨10, -6⟩, ⟨20, -10⟩]),
  (10, 12, [⟨-5, 3⟩, ⟨10, -6⟩, ⟨20, -10⟩]),
  (11, 12, [⟨-20, 8⟩, ⟨10, -4⟩, ⟨-15, 5⟩])]

def dC : Int := 4
def dA : Int := 1
def du : Int := 4
def kR : Int := 20
def P : Int := 80
def dW : Int := 20

/-- s0 = (25 + 7 sqrt 5)/10: 100 (5 s0^2 - 25 s0 + 19) = 5 (25 + 7r)^2 - 250 (25 + 7r) + 1900 = 0, and s0 > 5/2
  (the other root is (25 - 7 sqrt 5)/10 < 5/2) -/
def s10 : Z5 := ⟨25, 7⟩
theorem s0_ok : Z5.sub (Z5.add (Z5.mul (Z5.ofInt 5) (Z5.mul s10 s10)) (Z5.ofInt 1900)) (Z5.mul (Z5.ofInt 250) s10) = zero ∧
    Z5.pos (Z5.sub s10 (Z5.ofInt 25)) = true := by decide +kernel

def edgesOk (vs : List V) (d : Int) : Bool :=
  ((pairs vs.length).filter (fun (i, j) =>
    let e := vsub (nth vs i []) (nth vs j []); dot e e == sqz d)).length == 30

def container_ok_b : Bool :=
  CV.length == 12 && CF.length == 20 && edgesOk CV dC &&
  CF.all (fun a => CV.all (fun x => Z5.le (dot a x) (Z5.ofInt (dA * dC))) &&
    (CV.filter (fun x => dot a x == Z5.ofInt (dA * dC))).length == 3)

theorem container_ok : container_ok_b = true := by decide +kernel

/-- 5 c_f (times du): the sum of the 5 vertices -/
def centre (f : List Nat) : V := f.foldl (fun acc i => vadd acc (nth KV i [])) [zero, zero, zero]
def rho25 : Z5 := let c := centre (nth KF 0 []); dot c c      -- = 25 du^2 rho^2

def piece_ok_b : Bool :=
  KV.length == 20 && KF.length == 12 && edgesOk KV du &&
  KV.all (fun u => KV.contains (vneg u)) &&
  KF.all (fun f => f.length == 5 &&
    let c := centre f
    dot c c == rho25 &&
    KV.all (fun u => Z5.le (Z5.mul (Z5.ofInt 5) (dot c u)) (dot c c)) &&
    f.all (fun i => Z5.mul (Z5.ofInt 5) (dot c (nth KV i [])) == dot c c)) &&
  -- |w0|^2 = rho^2:  25 du^2 |W|^2 = dW^2 * (25 du^2 rho^2)
  Z5.mul (Z5.ofInt (25 * du * du)) (dot w0 w0) == Z5.mul (sqz dW) rho25 &&
  isZero (cross w0 vAxis) && Z5.pos (dot w0 vAxis)

theorem piece_ok : piece_ok_b = true := by decide +kernel

def det3 (m : List V) : Z5 := dot (nth m 0 []) (cross (nth m 1 []) (nth m 2 []))
def mvec (rows : List V) (u : V) : V := rows.map (fun r => dot r u)
/-- vertices of a piece times P: (kR R)(du u) + P t -/
def verts (p : Piece) : List V := KV.map (fun u => vadd (mvec p.rows u) p.t)

def orthOk (p : Piece) : Bool :=
  p.rows.length == 3 && p.rows.all (fun r => r.length == 3) &&
  (List.range 3).all (fun i => (List.range 3).all (fun k =>
    dot (nth p.rows i []) (nth p.rows k []) == (if i == k then sqz kR else zero))) &&
  det3 p.rows == Z5.ofInt (kR * kR * kR)

/-- centre piece: t = 0; corner piece at vertex j: t parallel to v_j (positive), |t|^2 = 4 rho^2:
  25 du^2 |P t|^2 = 4 P^2 (25 du^2 rho^2) -/
def centreOk (p : Piece) : Bool :=
  if p.j < 0 then isZero p.t
  else
    let vj := nth CV p.j.toNat []
    isZero (cross p.t vj) && Z5.pos (dot p.t vj) &&
    Z5.mul (Z5.ofInt (25 * du * du)) (dot p.t p.t) == Z5.mul (Z5.ofInt (4 * P * P)) rho25

/-- all vertices in s C with s = num/(10 m):  10 m (a_f . X) <= dA P num  (X = P x, a = dA a_f) -/
def insideOk (num : Z5) (m : Int) (p : Piece) : Bool :=
  (verts p).all (fun x => CF.all (fun a =>
    Z5.le (Z5.mul (Z5.ofInt (10 * m)) (dot a x)) (Z5.mul (Z5.ofInt (dA * P)) num)))

def sepOk (i j : Nat) (n : V) : Bool :=
  let a := (verts (nth record i ⟨[], [], 0⟩)).map (dot n)
  let b := (verts (nth record j ⟨[], [], 0⟩)).map (dot n)
  !isZero n && a.all (fun x => b.all (fun y => Z5.le x y))

def upper_ok_b : Bool :=
  record.length == 13 && record.all orthOk && record.all centreOk &&
  (record.filter (fun p => p.j < 0)).length == 1 &&
  (List.range 12).all (fun j => (record.filter (fun p => p.j == (j : Int))).length == 1) &&
  record.all (insideOk s10 1) &&
  planes.map (fun (i, j, _) => (i, j)) == pairs 13 &&
  planes.all (fun (i, j, n) => sepOk i j n)

theorem upper_ok : upper_ok_b = true := by decide +kernel

/-- s0 - 1/1000 = (2499 + 700 sqrt 5)/1000 = num/(10 * 100) -/
theorem broken_ok : record.all (insideOk ⟨2499, 700⟩ 100) = false := by decide +kernel

end PackLean.D87Dod
