import PackLean.Formal.E3iFar

/-!
# E3i 段 2 (b): the bundle (Bun) of the far R trees of D45DT

Design: `plan/A9k_dodintet_design.md` §5.2.  The kernel checks the segments `s_<tree>_<j>` in
`PackLean/E3i/Gen/F<f>_<k>.lean` (generated, not in git).  The bundle (generated by
`lean/tools/e3i/bundle.py`, also not in git) is in three layers:

* `Bun/F<f>_<k>.lean` (imports one Gen file): one `TreeR P c_<tree>` per tree, by chaining its segments with
  `E3iFar.seg_stepN` from `rRoots P.den` (`rRoots_eq`) to `[]` (`covers_nil`).
* `Bun/R<f>.lean` (imports the Bun files of one far file): `RecsOk recs<f>` from `rec_ok` per record
  (`headOk` by `decide +kernel`, the two trees from the layer above).
* `Bun/All.lean`: `RecsOk recsAll` (`recsOk_append`); with the n tree (`Bun/NTree.lean`) this is what
  `E3iFar.far_certR` asks for (`far_certK`).

The records `recs<f>` (`Bun/Recs.lean`) carry only `nb`, `mode`, `offU`, `offL` (the trees are `[]`):
`headOk` and `TreesR` do not read the trees, and the n tree reads only `nb`.
-/

namespace PackLean.E3i.BunCore

open PackLean.D28 (RBox rRoots)
open PackLean.D45DT (Prm FBoxL TreeCtx P ntreeRunL)
open PackLean.Formal.E3iFar (TreeR TreesR headOk)

/-- The first stack of every R tree. -/
theorem rRoots_eq : rRoots P.den =
    [⟨0, -17592186044416, -17592186044416, -17592186044416, 17592186044416, 17592186044416, 17592186044416⟩,
     ⟨1, -17592186044416, -17592186044416, -17592186044416, 17592186044416, 17592186044416, 17592186044416⟩,
     ⟨2, -17592186044416, -17592186044416, -17592186044416, 17592186044416, 17592186044416, 17592186044416⟩,
     ⟨3, -17592186044416, -17592186044416, -17592186044416, 17592186044416, 17592186044416, 17592186044416⟩] := by
  decide +kernel

/-- What `far_certR` asks of every record. -/
def RecsOk (Q : Prm) (recs : List FBoxL) : Prop := ∀ r ∈ recs, headOk Q r = true ∧ TreesR Q r

theorem recsOk_nil {Q : Prm} : RecsOk Q [] := fun _ h => by simp at h

theorem recsOk_cons {Q : Prm} {r : FBoxL} {rs : List FBoxL} (h : headOk Q r = true ∧ TreesR Q r)
    (t : RecsOk Q rs) : RecsOk Q (r :: rs) := by
  intro x hx
  rcases List.mem_cons.1 hx with rfl | hx
  · exact h
  · exact t x hx

theorem recsOk_append {Q : Prm} {a b : List FBoxL} (ha : RecsOk Q a) (hb : RecsOk Q b) :
    RecsOk Q (a ++ b) := by
  intro x hx
  rcases List.mem_append.1 hx with hx | hx
  · exact ha x hx
  · exact hb x hx

/-- One record from its two trees (the contexts as `E3h.ctxOf` writes them in the Gen files). -/
theorem rec_ok {Q : Prm} {r : FBoxL} (h : headOk Q r = true)
    (hU : TreeR Q (PackLean.E3h.ctxOf Q r.nb r.mode r.offU r.offL 0))
    (hL : TreeR Q (PackLean.E3h.ctxOf Q r.nb r.mode r.offU r.offL 1)) :
    headOk Q r = true ∧ TreesR Q r :=
  ⟨h, hU, hL⟩

end PackLean.E3i.BunCore

#assert_std_axioms PackLean.E3i.BunCore.rRoots_eq PackLean.E3i.BunCore.recsOk_append
  PackLean.E3i.BunCore.rec_ok
